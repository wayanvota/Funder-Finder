# Required: the ReAct agent's LLM
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Foundation data layer (Kindora MCP). Default works without a key.
KINDORA_MCP_URL=https://kindora-mcp.azurewebsites.net/mcp
# KINDORA_MCP_TOKEN=            # only if the endpoint later requires auth

# Optional: live web_search tool. Without this, the agent uses the index only.
# TAVILY_API_KEY=tvly-...
# WEB_SEARCH_MAX=6

# Optional tuning
# AGENT_MAX_TOOL_TURNS=5
# AGENT_MAX_TOKENS=1800
# CORS_ORIGINS=https://wayan.com,https://www.wayan.com
# LOG_LEVEL=INFO
